// ---- idle chat bubbles (context-aware mumbles) ----

string g_chat_text = "";

datetime g_chat_shown = 0;

datetime g_chat_next = 0;



void ChatBubble(string text, int ox, int oy)

{

   int w = 20 + StringLen(text) * 7;

   int h = 22;

   int bx = ox + 10, by = oy - 26;

   // bubble background

   string bg = "CHAT_BG";

   if (ObjectFind(0, bg) < 0)

   {

      ObjectCreate(0, bg, OBJ_RECTANGLE_LABEL, 0, 0, 0);

      ObjectSetInteger(0, bg, OBJPROP_CORNER, CORNER_LEFT_UPPER);

      ObjectSetInteger(0, bg, OBJPROP_BORDER_TYPE, BORDER_FLAT);

      ObjectSetInteger(0, bg, OBJPROP_BACK, false);

      ObjectSetInteger(0, bg, OBJPROP_SELECTABLE, false);

   }

   ObjectSetInteger(0, bg, OBJPROP_XDISTANCE, bx);

   ObjectSetInteger(0, bg, OBJPROP_YDISTANCE, by);

   ObjectSetInteger(0, bg, OBJPROP_XSIZE, w);

   ObjectSetInteger(0, bg, OBJPROP_YSIZE, h);

   ObjectSetInteger(0, bg, OBJPROP_BGCOLOR, clrWhiteSmoke);

   // text

   string lb = "CHAT_TXT";

   if (ObjectFind(0, lb) < 0)

   {

      ObjectCreate(0, lb, OBJ_LABEL, 0, 0, 0);

      ObjectSetInteger(0, lb, OBJPROP_CORNER, CORNER_LEFT_UPPER);

      ObjectSetInteger(0, lb, OBJPROP_FONTSIZE, 8);

      ObjectSetString(0, lb, OBJPROP_FONT, "Consolas");

      ObjectSetInteger(0, lb, OBJPROP_SELECTABLE, false);

   }

   ObjectSetString(0, lb, OBJPROP_TEXT, text);

   ObjectSetInteger(0, lb, OBJPROP_COLOR, clrBlack);

   ObjectSetInteger(0, lb, OBJPROP_XDISTANCE, bx + 4);

   ObjectSetInteger(0, lb, OBJPROP_YDISTANCE, by + 4);

}



void ChatHide()

{

   ObjectSetInteger(0, "CHAT_BG", OBJPROP_XSIZE, 0);

   ObjectSetInteger(0, "CHAT_BG", OBJPROP_YSIZE, 0);

   ObjectSetInteger(0, "CHAT_TXT", OBJPROP_XDISTANCE, -1000);

}



void PetChat(int ox, int oy, int red_cnt, int grn_cnt, int total)

{

   datetime now = TimeCurrent();

   // hide expired bubble

   if (g_chat_text != "" && now - g_chat_shown >= 6)

   {

      g_chat_text = "";

      ChatHide();

      g_chat_next = now + 20 + (rand() % 26);   // 20-45s gap

   }

   if (g_chat_text != "") return;

   if (now < g_chat_next) return;



   // pick phrase pool by portfolio mood

   string pool[8];

   int np = 0;

   if (total == 0)

   {

      pool[0] = "gak ada posisi, ngopi dulu ah";

      pool[1] = "tunggu sinyal, santai wae";

      pool[2] = "liatin chart sambil rebahan";

      pool[3] = "cuan nanti, sabar dulu";

      pool[4] = "mode ngantuk, bsk aja deh";

      pool[5] = "gak gerak, bengong";

      pool[6] = "tenang... semua butuh waktu";

      pool[7] = "bolong-bolong, enak tidur";

      np = 8;

   }

   else if (red_cnt > 0 && grn_cnt == 0)

   {

      pool[0] = "padamkan api, dengan tepung singkong!";

      pool[1] = "semua merah kayak bendera";

      pool[2] = "waduh... kebakaran portfolio";

      pool[2] = "demi apa, merah semua?";

      pool[3] = "ini lagi musim petir, tahan";

      pool[4] = "udah, jualan gorengan aja";

      pool[5] = "nyesek, tapi harus kuat";

      pool[6] = "merah merona, hati tersipu";

      pool[7] = "sudah-sudah, ngopi dulu";

      np = 8;

   }

   else if (grn_cnt > 0 && red_cnt == 0)

   {

      pool[0] = "hahaha, cuan cuan cuan";

      pool[1] = "ijo semua, mantap jiwa";

      pool[2] = "udah untung, beli es teh";

      pool[3] = "asik, tinggal nikmatin";

      pool[4] = "hijau-hijau, kayak sawah";

      pool[5] = "jagoan nih, salut!";

      pool[6] = "cuan dikit, gak papa";

      pool[7] = "okelah, beli bakso extra";

      np = 8;

   }

   else if (red_cnt > grn_cnt)

   {

      pool[0] = "kupas bawang aja 700rb/kg";

      pool[1] = "banyak merah, campur ijo dikit";

      pool[2] = "sedikit lagi, jangan nyerah";

      pool[3] = "merah-ijo, kayak lampu lalu lintas";

      pool[4] = "yang ijo dipuji, yang merah disabarin";

      pool[5] = "duh, jualan sayur aja lah";

      pool[6] = "sabar, cuan itu nanti";

      pool[7] = "campur-campur, bingung bgt";

      np = 8;

   }

   else

   {

      pool[0] = "ijo dominan, sip!";

      pool[1] = "lumayan cuan, jajan dulu";

      pool[2] = "hijau banyak, merah dikit wajar";

      pool[3] = "oke oke, tinggal dikit lagi";

      pool[4] = "seimbang nih, mantap";

      pool[5] = "bagus, pertahankan";

      pool[6] = "udah ijo, jangan serakah";

      pool[7] = "enak, tinggal panen";

      np = 8;

   }

   int idx = MathRand() % np;

   g_chat_text = pool[idx];

   g_chat_shown = now;

   ChatBubble(g_chat_text, ox, oy);

}



void PetRender()

{

   if (!InpPetEnabled)

   {

      for (int i = 0; i < 1088; i++) ObjectDelete(0, "PET_" + (string)i);

      return;

   }

   int SCALE = 4;

   int PW = 32 * SCALE, PH = 34 * SCALE;

   double t = (double)g_pet_frame * 0.025;

   g_pet_x = (int)(MathSin(t) * 160.0);

   int bob = (int)(MathAbs(MathSin(t * 2.5)) * 4.0);

   int chart_h = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);

   int ox = 180 + g_pet_x;

   int oy = chart_h - PH - 12 + bob;

   double vel = MathCos(t);

   int row = 0;

   if (MathAbs(vel) > 0.15) row = (vel > 0) ? 1 : 2;

   int nf = (row == 0) ? 6 : 8;

   int col = (g_pet_frame / 8) % nf;

   string fname = ((row == 0) ? "I" : (row == 1 ? "R" : "L")) + (string)col;

   uint arr[];

   if (fname == "I0") ArrayCopy(arr, PET_I0);

   else if (fname == "I1") ArrayCopy(arr, PET_I1);

   else if (fname == "I2") ArrayCopy(arr, PET_I2);

   else if (fname == "I3") ArrayCopy(arr, PET_I3);

   else if (fname == "I4") ArrayCopy(arr, PET_I4);

   else if (fname == "I5") ArrayCopy(arr, PET_I5);

   else if (fname == "R0") ArrayCopy(arr, PET_R0);

   else if (fname == "R1") ArrayCopy(arr, PET_R1);

   else if (fname == "R2") ArrayCopy(arr, PET_R2);

   else if (fname == "R3") ArrayCopy(arr, PET_R3);

   else if (fname == "R4") ArrayCopy(arr, PET_R4);

   else if (fname == "R5") ArrayCopy(arr, PET_R5);

   else if (fname == "R6") ArrayCopy(arr, PET_R6);

   else if (fname == "R7") ArrayCopy(arr, PET_R7);

   else if (fname == "L0") ArrayCopy(arr, PET_L0);

   else if (fname == "L1") ArrayCopy(arr, PET_L1);

   else if (fname == "L2") ArrayCopy(arr, PET_L2);

   else if (fname == "L3") ArrayCopy(arr, PET_L3);

   else if (fname == "L4") ArrayCopy(arr, PET_L4);

   else if (fname == "L5") ArrayCopy(arr, PET_L5);

   else if (fname == "L6") ArrayCopy(arr, PET_L6);

   else if (fname == "L7") ArrayCopy(arr, PET_L7);

   for (int i = 0; i < 1088; i++)

   {

      uint c = arr[i];

      if (c == 0) { ObjectSetInteger(0, "PET_" + (string)i, OBJPROP_XSIZE, 0); continue; }

      int cx = i % 32, cy = i / 32;

      PetRect("PET_" + (string)i, ox + cx * SCALE, oy + cy * SCALE, SCALE, SCALE, (color)(c & 0xFFFFFF));

   }

   // --- idle chat bubble (context-aware) ---

   int red_cnt = 0, grn_cnt = 0, tot = 0;

   for (int p = PositionsTotal() - 1; p >= 0; p--)

   {

      ulong tk = PositionGetTicket(p);

      if (tk == 0) continue;

      if ((int)PositionGetInteger(POSITION_MAGIC) != g_magic) continue;

      if (PositionGetString(POSITION_SYMBOL) != _Symbol) continue;

      tot++;

      if (PositionGetDouble(POSITION_PROFIT) < 0) red_cnt++; else grn_cnt++;

   }

   PetChat(ox, oy, red_cnt, grn_cnt, tot);

}

void OnTick()







{







   if (g_hud_created == 0) { HudCreate(); g_hud_created = 1; }







   HudUpdate();







   PetRender();

   // ---- brand HUD mode: skip trading ----
   if (InpBrandHUDOnly)
   {
      ChartRedraw();
      return;
   }








   UpdateRiskState();







   // Margin call sound (once per hour)







   double ml = AccountInfoDouble(ACCOUNT_MARGIN_LEVEL);







   if (ml > 0 && ml < 100 && TimeCurrent() - g_snd_guard > 3600) Snd(SND_MARGIN);







   if (RiskGuardTriggered()) return;







   ManagePartial();







   static datetime last_m15 = 0;







   datetime current_m15 = iTime(_Symbol, PERIOD_M15, 0);







   if (current_m15 != last_m15)







   {







      last_m15 = current_m15;







      ComputeSignal();







   }







   if (g_signal > 0)







   {







      if (PosCount(POSITION_TYPE_BUY) > 0) { g_signal = 0; return; }







      if (PosCount(POSITION_TYPE_SELL) > 0)







      {







         CloseAll("REVERSE_TO_BUY");







         g_signal = 0;







         return;







      }







      OpenPos(ORDER_TYPE_BUY);







   }







   else if (g_signal < 0)







   {







      if (PosCount(POSITION_TYPE_SELL) > 0) { g_signal = 0; return; }







      if (PosCount(POSITION_TYPE_BUY) > 0)







      {







         CloseAll("REVERSE_TO_SELL");







         g_signal = 0;







         return;







      }







      OpenPos(ORDER_TYPE_SELL);







   }







   // Pet animation: move pet every 2 seconds







   if (g_pet_frame == 0) { g_pet_x++; if (g_pet_x > 100) g_pet_x = -100; }







   g_pet_frame = (g_pet_frame + 1) % 40;







}