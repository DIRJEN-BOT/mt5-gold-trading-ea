void HudCreate()
{
   if (ObjectFind(0, HUD_PREFIX + "BG") >= 0) return;

   g_hud_obj_count = 0;

   const int X = 8, Y = 48, W = 270, H = 234;

   // ================= PANEL =================
   HudObj("BG", 0, X, Y, W, H);
   ObjectSetInteger(0, HUD_PREFIX+"BG", OBJPROP_BGCOLOR, (color)0x1B140E);
   ObjectSetInteger(0, HUD_PREFIX+"BG", OBJPROP_BORDER_TYPE, BORDER_FLAT);
   ObjectSetInteger(0, HUD_PREFIX+"BG", OBJPROP_BORDER_COLOR, (color)0x6A5A4A);

   // left status accent strip (full height, dynamic color)
   HudObj("ACCENT", 0, X, Y, 3, H);
   ObjectSetInteger(0, HUD_PREFIX+"ACCENT", OBJPROP_BGCOLOR, clrGray);

   // ================= TITLE BAR =================
   HudObj("TITLE_BG", 0, X+3, Y, W-3, 26);
   ObjectSetInteger(0, HUD_PREFIX+"TITLE_BG", OBJPROP_BGCOLOR, (color)0x0E141B);

   // gradient strip (30 vertical bars, dark -> accent)
   for (int i = 0; i < 30; i++)
   {
      HudObj("GRAD_" + (string)i, 0, X + 3 + i * 9, Y, 9, 26);
      ObjectSetInteger(0, HUD_PREFIX+"GRAD_" + (string)i, OBJPROP_BGCOLOR, (color)0x16222E);
      ObjectSetInteger(0, HUD_PREFIX+"GRAD_" + (string)i, OBJPROP_BORDER_COLOR, (color)0x16222E);
   }

   // dynamic status underline
   HudObj("TITLE_LINE", 0, X+3, Y+25, W-3, 2);
   ObjectSetInteger(0, HUD_PREFIX+"TITLE_LINE", OBJPROP_BGCOLOR, clrGray);

   // title text
   HudObj("TITLE", 1, X+14, Y+5, 0, 0);
   ObjectSetInteger(0, HUD_PREFIX+"TITLE", OBJPROP_FONTSIZE, 9);
   ObjectSetString(0, HUD_PREFIX+"TITLE", OBJPROP_FONT, "Consolas");
   ObjectSetString(0, HUD_PREFIX+"TITLE", OBJPROP_TEXT, "VILONA SYSTEMATIC v1");

   // signal status dot (top right)
   HudObj("SIG_DOT", 0, X+W-24, Y+7, 12, 12);
   ObjectSetInteger(0, HUD_PREFIX+"SIG_DOT", OBJPROP_BGCOLOR, clrGray);

   // ================= SECTION HEADERS =================
   HudObj("HB_ACCT", 0, X+12, Y+52, 4, 12);
   ObjectSetInteger(0, HUD_PREFIX+"HB_ACCT", OBJPROP_BGCOLOR, (color)0xF6823B);
   HudObj("H_ACCT", 1, X+22, Y+51, 0, 0);
   ObjectSetInteger(0, HUD_PREFIX+"H_ACCT", OBJPROP_FONTSIZE, 8);
   ObjectSetString(0, HUD_PREFIX+"H_ACCT", OBJPROP_FONT, "Consolas");
   ObjectSetString(0, HUD_PREFIX+"H_ACCT", OBJPROP_TEXT, "ACCOUNT");

   HudObj("HB_RISK", 0, X+12, Y+106, 4, 12);
   ObjectSetInteger(0, HUD_PREFIX+"HB_RISK", OBJPROP_BGCOLOR, (color)0x0B9EF5);
   HudObj("H_RISK", 1, X+22, Y+105, 0, 0);
   ObjectSetInteger(0, HUD_PREFIX+"H_RISK", OBJPROP_FONTSIZE, 8);
   ObjectSetString(0, HUD_PREFIX+"H_RISK", OBJPROP_FONT, "Consolas");
   ObjectSetString(0, HUD_PREFIX+"H_RISK", OBJPROP_TEXT, "RISK");

   HudObj("HB_SIG", 0, X+12, Y+149, 4, 12);
   ObjectSetInteger(0, HUD_PREFIX+"HB_SIG", OBJPROP_BGCOLOR, clrGray);
   HudObj("H_SIG", 1, X+22, Y+148, 0, 0);
   ObjectSetInteger(0, HUD_PREFIX+"H_SIG", OBJPROP_FONTSIZE, 8);
   ObjectSetString(0, HUD_PREFIX+"H_SIG", OBJPROP_FONT, "Consolas");
   ObjectSetString(0, HUD_PREFIX+"H_SIG", OBJPROP_TEXT, "SIGNAL");

   HudObj("HB_POS", 0, X+12, Y+182, 4, 12);
   ObjectSetInteger(0, HUD_PREFIX+"HB_POS", OBJPROP_BGCOLOR, (color)0xA6B814);
   HudObj("H_POS", 1, X+22, Y+181, 0, 0);
   ObjectSetInteger(0, HUD_PREFIX+"H_POS", OBJPROP_FONTSIZE, 8);
   ObjectSetString(0, HUD_PREFIX+"H_POS", OBJPROP_FONT, "Consolas");
   ObjectSetString(0, HUD_PREFIX+"H_POS", OBJPROP_TEXT, "POSITION");

   // ================= ACCOUNT ROWS (equity big) =================
   HudObj("EQ_L", 1, X+12, Y+64, 0, 0);
   ObjectSetInteger(0, HUD_PREFIX+"EQ_L", OBJPROP_FONTSIZE, 8);
   ObjectSetString(0, HUD_PREFIX+"EQ_L", OBJPROP_FONT, "Consolas");
   ObjectSetString(0, HUD_PREFIX+"EQ_L", OBJPROP_TEXT, "EQUITY");

   HudObj("EQ_BIG", 1, X+12, Y+59, 0, 0);
   ObjectSetInteger(0, HUD_PREFIX+"EQ_BIG", OBJPROP_FONTSIZE, 14);
   ObjectSetString(0, HUD_PREFIX+"EQ_BIG", OBJPROP_FONT, "Consolas Bold");

   // ================= RISK ROWS (day P&L big) =================
   HudObj("DAY_L", 1, X+12, Y+121, 0, 0);
   ObjectSetInteger(0, HUD_PREFIX+"DAY_L", OBJPROP_FONTSIZE, 8);
   ObjectSetString(0, HUD_PREFIX+"DAY_L", OBJPROP_FONT, "Consolas");

   HudObj("DAY_BIG", 1, X+12, Y+117, 0, 0);
   ObjectSetInteger(0, HUD_PREFIX+"DAY_BIG", OBJPROP_FONTSIZE, 12);
   ObjectSetString(0, HUD_PREFIX+"DAY_BIG", OBJPROP_FONT, "Consolas Bold");

   // ================= SIGNAL ROWS (badge big) =================
   HudObj("SIG_L", 1, X+12, Y+165, 0, 0);
   ObjectSetInteger(0, HUD_PREFIX+"SIG_L", OBJPROP_FONTSIZE, 8);
   ObjectSetString(0, HUD_PREFIX+"SIG_L", OBJPROP_FONT, "Consolas");

   HudObj("SIG_BADGE", 1, X+12, Y+163, 0, 0);
   ObjectSetInteger(0, HUD_PREFIX+"SIG_BADGE", OBJPROP_FONTSIZE, 10);
   ObjectSetString(0, HUD_PREFIX+"SIG_BADGE", OBJPROP_FONT, "Consolas Bold");

   // ================= STANDARD ROWS (label/value, 8px) =================
   string rows[] = {"BAL_L","BAL_V","MGN_L","MGN_V","FREE_L","FREE_V",
                    "PK_L","PK_V",
                    "FLT_L","FLT_V",
                    "POS_L","POS_V","OP_L","OP_V","PNL_L","PNL_V","FT_L","FT_V"};
   int rowsY[]  = {81,81, 90,90, 99,99,
                   131,131,
                   176,176,
                   199,199, 208,208, 217,217, 226,226};
   for (int i = 0; i < ArraySize(rows); i++)
   {
      HudObj(rows[i], 1, X+12, Y+rowsY[i], 0, 0);
      ObjectSetInteger(0, HUD_PREFIX+rows[i], OBJPROP_FONTSIZE, 8);
      ObjectSetString(0, HUD_PREFIX+rows[i], OBJPROP_FONT, "Consolas");
   }

   // ================= DIVIDERS =================
   HudObj("DIV1", 0, X+12, Y+105, W-24, 1);
   ObjectSetInteger(0, HUD_PREFIX+"DIV1", OBJPROP_BGCOLOR, (color)0x50402E);
   HudObj("DIV2", 0, X+12, Y+148, W-24, 1);
   ObjectSetInteger(0, HUD_PREFIX+"DIV2", OBJPROP_BGCOLOR, (color)0x50402E);
   HudObj("DIV3", 0, X+12, Y+183, W-24, 1);
   ObjectSetInteger(0, HUD_PREFIX+"DIV3", OBJPROP_BGCOLOR, (color)0x50402E);

   // ================= MAXDD GAUGE =================
   HudObj("GAUGE_BG", 0, X+12, Y+139, W-24, 6);
   ObjectSetInteger(0, HUD_PREFIX+"GAUGE_BG", OBJPROP_BGCOLOR, (color)0x30251A);
   HudObj("GAUGE_FILL", 0, X+12, Y+139, 1, 6);
   ObjectSetInteger(0, HUD_PREFIX+"GAUGE_FILL", OBJPROP_BGCOLOR, (color)0x6EE023);

   // ================= SPARKLINE =================
   HudObj("SPARK_BG", 0, X+8, Y+234, W-16, 16);
   ObjectSetInteger(0, HUD_PREFIX+"SPARK_BG", OBJPROP_BGCOLOR, (color)0x140F0A);
   for (int i = 0; i < 140; i++)
      HudObj("SPARK_" + (string)i, 0, X+10+i*2, Y+249, 1, 1);

   ChartRedraw();
}









void HudDelete()







{







   for (int i = 0; i < g_hud_obj_count; i++)







      ObjectDelete(0, g_hud_names[i]);







   g_hud_obj_count = 0;







}







void HudUpdate()
{
   const int X = 8, Y = 48, W = 270;

   double eq  = AccountInfoDouble(ACCOUNT_EQUITY);
   double bal = AccountInfoDouble(ACCOUNT_BALANCE);
   double ml  = AccountInfoDouble(ACCOUNT_MARGIN_LEVEL);
   double fm  = AccountInfoDouble(ACCOUNT_MARGIN_FREE);
   double peak = MathMax(g_peak_equity, eq);
   double day_pnl = (g_day_start_equity > 0) ? (eq - g_day_start_equity) : 0.0;
   double dd_pct = (peak > 0) ? ((peak - eq) / peak * 100.0) : 0.0;

   color lbl = (color)0xB8A28C;   // cool gray-blue label
   color grn = (color)0x6EE023;   // buy / profit green
   color red = (color)0x4D4DFF;   // sell / loss red
   color gld = (color)0x74C6F0;   // gold / neutral warn

   // ---- status accent ----
   color acc = (g_signal > 0) ? grn : (g_signal < 0) ? red : (color)0xB4AAA0;

   // ---- title ----
   HudText("TITLE", "VILONA SYSTEMATIC v1   " + _Symbol, clrWhite);

   ObjectSetInteger(0, HUD_PREFIX+"ACCENT",     OBJPROP_BGCOLOR, acc);
   ObjectSetInteger(0, HUD_PREFIX+"TITLE_LINE", OBJPROP_BGCOLOR, acc);
   ObjectSetInteger(0, HUD_PREFIX+"SIG_DOT",    OBJPROP_BGCOLOR, acc);
   ObjectSetInteger(0, HUD_PREFIX+"HB_SIG",     OBJPROP_BGCOLOR, acc);

   // dynamic title-bar gradient
   if (g_signal > 0)
      for (int i = 0; i < 30; i++) ObjectSetInteger(0, HUD_PREFIX+"GRAD_"+(string)i, OBJPROP_BGCOLOR, gradBuy[i]);
   else if (g_signal < 0)
      for (int i = 0; i < 30; i++) ObjectSetInteger(0, HUD_PREFIX+"GRAD_"+(string)i, OBJPROP_BGCOLOR, gradSell[i]);
   else
      for (int i = 0; i < 30; i++) ObjectSetInteger(0, HUD_PREFIX+"GRAD_"+(string)i, OBJPROP_BGCOLOR, gradFlat[i]);

   // ---- account section ----
   HudText("H_ACCT", "ACCOUNT", (color)0xD2B89D);
   HudText("EQ_L", "EQUITY", lbl);
   string eqs = Money(eq);
   HudText("EQ_BIG", eqs, (eq >= bal) ? grn : red);
   ObjectSetInteger(0, HUD_PREFIX+"EQ_BIG", OBJPROP_XDISTANCE, X + W - 12 - StringLen(eqs) * 8);

   HudText("BAL_L", "Balance", lbl);
   HudText("BAL_V", Money(bal), gld);

   color mlc = (ml > 0 && ml < 200) ? red : (ml < 400 ? gld : grn);
   HudText("MGN_L", "Margin Lv", lbl);
   HudText("MGN_V", (ml > 0) ? DoubleToString(ml, 0) + "%" : "--", mlc);

   HudText("FREE_L", "Free", lbl);
   HudText("FREE_V", Money(fm), (fm > 0) ? (color)0xDDCBAE : red);

   // ---- risk section ----
   HudText("H_RISK", "RISK", (color)0xD2B89D);
   HudText("DAY_L", "DAY P&L" + (g_daily_locked ? "  LOCKED" : ""), lbl);
   string daystr = (day_pnl >= 0 ? "+" : "-") + Money(MathAbs(day_pnl));
   HudText("DAY_BIG", daystr, (day_pnl >= 0) ? grn : red);
   ObjectSetInteger(0, HUD_PREFIX+"DAY_BIG", OBJPROP_XDISTANCE, X + W - 12 - StringLen(daystr) * 7);

   color ddc = (dd_pct > 15) ? red : (dd_pct > 5 ? gld : grn);
   HudText("PK_L", "Peak  DD", lbl);
   HudText("PK_V", Money(peak) + "  " + DoubleToString(dd_pct, 1) + "%", ddc);

   // maxDD gauge
   double frac = (InpMaxDDTotalPct > 0) ? MathMin(dd_pct / InpMaxDDTotalPct, 1.0) : 0.0;
   ObjectSetInteger(0, HUD_PREFIX+"GAUGE_FILL", OBJPROP_XSIZE, (int)MathMax(1, frac * (W - 24)));
   ObjectSetInteger(0, HUD_PREFIX+"GAUGE_FILL", OBJPROP_BGCOLOR, (frac > 0.9) ? red : (frac > 0.5 ? gld : grn));

   // ---- signal section ----
   HudText("H_SIG", "SIGNAL", (color)0xD2B89D);
   string sigstr = (g_signal > 0) ? "BUY" : (g_signal < 0) ? "SELL" : "FLAT";
   string arrow  = (g_signal > 0) ? "  %B2" : (g_signal < 0) ? "  %BC" : "";
   string badge  = sigstr + arrow;
   HudText("SIG_L", "Signal", lbl);
   HudText("SIG_BADGE", badge, acc);
   ObjectSetInteger(0, HUD_PREFIX+"SIG_BADGE", OBJPROP_XDISTANCE, X + W - 12 - StringLen(badge) * 6);

   color fltc = lbl;
   string flt = "?";
   if (g_ema_h != INVALID_HANDLE)
   {
      double eb[1];
      if (CopyBuffer(g_ema_h, 0, 0, 1, eb) > 0)
      {
         double c0 = SigClose();
         bool above = (c0 > eb[0]);
         flt = "EMA" + (string)InpEMATrend + " " + (above ? "ABOVE" : "below");
         fltc = above ? grn : red;
      }
   }
   HudText("FLT_L", "Filter", lbl);
   HudText("FLT_V", flt, fltc);

   // ---- position section ----
   HudText("H_POS", "POSITION", (color)0xD2B89D);
   ulong ticket = 0;
   ENUM_POSITION_TYPE ptype = POSITION_TYPE_BUY;
   double open = 0.0, vol = 0.0, sl = 0.0, pnl = 0.0;
   for (int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong t = PositionGetTicket(i);
      if (t == 0) continue;
      if ((int)PositionGetInteger(POSITION_MAGIC) != g_magic) continue;
      if (PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      ticket = t;
      ptype = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      open = PositionGetDouble(POSITION_PRICE_OPEN);
      vol = PositionGetDouble(POSITION_VOLUME);
      sl = PositionGetDouble(POSITION_SL);
      pnl = PositionGetDouble(POSITION_PROFIT);
      break;
   }
   if (ticket != 0)
   {
      double cur = (ptype == POSITION_TYPE_BUY) ? SymbolInfoDouble(_Symbol, SYMBOL_BID)
                                                : SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      double pts = (ptype == POSITION_TYPE_BUY) ? (cur - open) / g_point
                                                : (open - cur) / g_point;
      color pc = (ptype == POSITION_TYPE_BUY) ? grn : red;
      HudText("POS_L", "Position", lbl);
      HudText("POS_V", (ptype == POSITION_TYPE_BUY ? "BUY" : "SELL") + " " + DoubleToString(vol, 2) + " lot", pc);
      HudText("OP_L", "Open / SL", lbl);
      HudText("OP_V", DoubleToString(open, g_digits) + " / " + DoubleToString(sl, g_digits), gld);
      HudText("PNL_L", "PnL", lbl);
      HudText("PNL_V", Money(pnl) + "  " + (pts >= 0 ? "+" : "") + DoubleToString(pts, 0) + " pts",
              pnl >= 0 ? grn : red);
   }
   else
   {
      HudText("POS_L", "Position", lbl);
      HudText("POS_V", "none", (color)0x8A7A6A);
      HudText("OP_L", "Open / SL", lbl);
      HudText("OP_V", " ", (color)0x8A7A6A);
      HudText("PNL_L", "PnL", lbl);
      HudText("PNL_V", " ", (color)0x8A7A6A);
   }

   // ---- footer ----
   color gc = g_maxdd_active ? red : grn;
   HudText("FT_L", "GUARD " + (g_maxdd_active ? "HIT!" : "OK") + "  MAXDD " + DoubleToString(InpMaxDDTotalPct, 1) + "%", gc);
   HudText("FT_V", TimeToString(TimeCurrent(), TIME_SECONDS), (color)0xB8A28C);

   // ---- right-align all _V values ----
   for (int i = 0; i < g_hud_obj_count; i++)
   {
      string nm = g_hud_names[i];
      if (StringFind(nm, "_V") < 0) continue;
      string txt = ObjectGetString(0, nm, OBJPROP_TEXT);
      ObjectSetInteger(0, nm, OBJPROP_XDISTANCE, X + W - 12 - StringLen(txt) * 5);
   }

   // ---- live equity sparkline (sample once per second) ----
   datetime now = TimeCurrent();
   if (g_eq_last_t != now)
   {
      g_eq_last_t = now;
      for (int i = 139; i > 0; i--) g_eq_hist[i] = g_eq_hist[i-1];
      g_eq_hist[0] = eq;
      if (g_eq_hist_n < 140) g_eq_hist_n++;
   }
   double mn = eq, mx = eq;
   for (int i = 0; i < g_eq_hist_n; i++) { mn = MathMin(mn, g_eq_hist[i]); mx = MathMax(mx, g_eq_hist[i]); }
   double span = (mx - mn > 0) ? (mx - mn) : 1.0;
   for (int i = 0; i < 140; i++)
   {
      string bn = HUD_PREFIX + "SPARK_" + (string)i;
      if (i >= g_eq_hist_n) { ObjectSetInteger(0, bn, OBJPROP_XSIZE, 0); continue; }
      int bh = (int)MathMax(1, (g_eq_hist[i] - mn) / span * 14.0);
      ObjectSetInteger(0, bn, OBJPROP_XSIZE, 2);
      ObjectSetInteger(0, bn, OBJPROP_YSIZE, bh);
      ObjectSetInteger(0, bn, OBJPROP_YDISTANCE, Y + 249 - bh);
      color bc = (i == 0) ? (color)0xEED322 : ((g_eq_hist[i] >= g_eq_hist[i-1]) ? grn : red);
      ObjectSetInteger(0, bn, OBJPROP_BGCOLOR, bc);
   }

   ChartRedraw();
}









string RiskKey(string suffix)







{







   return StringFormat("VHS1_%s_%d_%s", _Symbol, InpMagic, suffix);







}







void SaveRiskState()







{







   if (IsTester()) return;







   datetime now = TimeCurrent();







   if (now == g_last_risk_save) return;







   GlobalVariableSet(RiskKey("peak"), g_peak_equity);







   GlobalVariableSet(RiskKey("day_eq"), g_day_start_equity);







   GlobalVariableSet(RiskKey("day_key"), (double)g_day_key);







   GlobalVariableSet(RiskKey("daily_lock"), g_daily_locked ? 1.0 : 0.0);







   g_last_risk_save = now;







}







void LoadRiskState()







{







   double eq = AccountInfoDouble(ACCOUNT_EQUITY);







   g_peak_equity = eq;







   g_day_start_equity = eq;







   g_day_key = CurrentDayKey();







   g_maxdd_active = false;







   g_daily_locked = false;







   if (IsTester()) return;







   string peak_key = RiskKey("peak");







   string day_eq_key = RiskKey("day_eq");







   string day_key = RiskKey("day_key");







   if (GlobalVariableCheck(peak_key))







   {







      double saved_peak = GlobalVariableGet(peak_key);







      if (saved_peak > 0.0 && saved_peak < eq * 1000.0)







         g_peak_equity = MathMax(eq, saved_peak);







   }







   if (GlobalVariableCheck(day_key) && (int)GlobalVariableGet(day_key) == g_day_key && GlobalVariableCheck(day_eq_key))







   {







      double saved_day_eq = GlobalVariableGet(day_eq_key);







      if (saved_day_eq > 0.0 && saved_day_eq < eq * 1000.0)







         g_day_start_equity = saved_day_eq;







   }







   string daily_lock_key = RiskKey("daily_lock");







   if (GlobalVariableCheck(daily_lock_key)) g_daily_locked = GlobalVariableGet(daily_lock_key) > 0.5;







   SaveRiskState();







}







int OnInit()







{







   g_magic = InpMagic;







   g_trade.SetExpertMagicNumber(g_magic);







   g_trade.SetDeviationInPoints(100);







   g_trade.SetTypeFilling(ORDER_FILLING_RETURN);







   g_point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);







   g_digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);







   LoadRiskState();







   if (InpRiskPct <= 0.0 || InpRiskPct > 1.0)







      Print("WARNING: paper contract expects InpRiskPct in (0, 1.0]. risk%=", InpRiskPct);







   if (InpMaxDDTotalPct <= 0.0 || InpDailyLossPct <= 0.0)







      return INIT_PARAMETERS_INCORRECT;







   int tf = InpSignalTF;







   if (tf == 240)







   {







      g_ema_h = iMA(_Symbol, PERIOD_H4, InpEMATrend, 0, MODE_EMA, PRICE_CLOSE);







      g_adx_h = iADX(_Symbol, PERIOD_H4, InpADXPeriod);







      g_atr_h = iATR(_Symbol, PERIOD_H4, InpATRPeriod);







      g_ema_h4_h = INVALID_HANDLE;







      g_ema_gate_h = (InpEMAGate > 0) ? iMA(_Symbol, PERIOD_H4, InpEMAGate, 0, MODE_EMA, PRICE_CLOSE) : INVALID_HANDLE;







   }







   else if (tf == 1440)







   {







      g_ema_h = iMA(_Symbol, PERIOD_D1, InpEMATrend, 0, MODE_EMA, PRICE_CLOSE);







      g_adx_h = iADX(_Symbol, PERIOD_D1, InpADXPeriod);







      g_atr_h = iATR(_Symbol, PERIOD_D1, InpATRPeriod);







      g_ema_h4_h = iMA(_Symbol, PERIOD_H4, InpH4EMA, 0, MODE_EMA, PRICE_CLOSE);







      g_ema_gate_h = (InpEMAGate > 0) ? iMA(_Symbol, PERIOD_D1, InpEMAGate, 0, MODE_EMA, PRICE_CLOSE) : INVALID_HANDLE;







   }







   else







   {







      g_ema_h = iMA(_Symbol, PERIOD_H1, InpEMATrend, 0, MODE_EMA, PRICE_CLOSE);







      g_adx_h = iADX(_Symbol, PERIOD_H1, InpADXPeriod);







      g_atr_h = iATR(_Symbol, PERIOD_H1, InpATRPeriod);







      g_ema_h4_h = INVALID_HANDLE;







      g_ema_gate_h = (InpEMAGate > 0) ? iMA(_Symbol, PERIOD_H1, InpEMAGate, 0, MODE_EMA, PRICE_CLOSE) : INVALID_HANDLE;







   }







   Print("Vilona Systematic v1 tf=", tf,







         " risk%=", InpRiskPct,







         " maxDD%=", InpMaxDDTotalPct,







         " daily%=", InpDailyLossPct,







         " magic=", g_magic,







         " one-position=true");







   Print("PERM terminal=", TerminalInfoInteger(TERMINAL_TRADE_ALLOWED),







         " mql=", MQLInfoInteger(MQL_TRADE_ALLOWED),







         " acct=", AccountInfoInteger(ACCOUNT_TRADE_ALLOWED),







         " acctExpert=", AccountInfoInteger(ACCOUNT_TRADE_EXPERT));







   return INIT_SUCCEEDED;







}







void OnDeinit(const int reason)







{







   HudDelete();







   SaveRiskState();







   if (g_ema_h4_h != INVALID_HANDLE) { IndicatorRelease(g_ema_h4_h); g_ema_h4_h = INVALID_HANDLE; }







   if (g_ema_gate_h != INVALID_HANDLE) { IndicatorRelease(g_ema_gate_h); g_ema_gate_h = INVALID_HANDLE; }







   if (g_atr_h != INVALID_HANDLE) { IndicatorRelease(g_atr_h); g_atr_h = INVALID_HANDLE; }







}







bool MarketOpen()







{







   return (SymbolInfoInteger(_Symbol, SYMBOL_TRADE_MODE) == SYMBOL_TRADE_MODE_FULL);







}







double SigClose()







{







   if (InpSignalTF == 240) return iClose(_Symbol, PERIOD_H4, 0);







   if (InpSignalTF == 1440) return iClose(_Symbol, PERIOD_D1, 0);







   return iClose(_Symbol, PERIOD_H1, 0);







}







bool SigCopyHigh(double &buf[], int start, int count)







{







   if (InpSignalTF == 240) return CopyHigh(_Symbol, PERIOD_H4, start, count, buf) > 0;







   if (InpSignalTF == 1440) return CopyHigh(_Symbol, PERIOD_D1, start, count, buf) > 0;







   return CopyHigh(_Symbol, PERIOD_H1, start, count, buf) > 0;







}







bool SigCopyLow(double &buf[], int start, int count)







{







   if (InpSignalTF == 240) return CopyLow(_Symbol, PERIOD_H4, start, count, buf) > 0;







   if (InpSignalTF == 1440) return CopyLow(_Symbol, PERIOD_D1, start, count, buf) > 0;







   return CopyLow(_Symbol, PERIOD_H1, start, count, buf) > 0;







}







double ComputeLot()







{







   double eq = AccountInfoDouble(ACCOUNT_EQUITY);







   if (eq <= 0.0) return InpMinLot;







   double tick_value = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);







   double tick_size = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);







   if (tick_size <= 0.0) tick_size = g_point;







   double sl_dist = InpStopLossPts * g_point;







   double loss_per_lot = (sl_dist / tick_size) * tick_value;







   if (loss_per_lot <= 0.0) return InpMinLot;







   double lot = (eq * InpRiskPct / 100.0) / loss_per_lot;







   lot = NormalizeDouble(lot, 2);







   if (lot < InpMinLot) lot = InpMinLot;







   if (lot > InpMaxLot) lot = InpMaxLot;







   return lot;







}







int PosCount(ENUM_POSITION_TYPE type)







{







   int count = 0;







   for (int i = PositionsTotal() - 1; i >= 0; i--)







   {







      ulong ticket = PositionGetTicket(i);







      if (ticket == 0) continue;







      if ((int)PositionGetInteger(POSITION_MAGIC) != g_magic) continue;







      if (PositionGetString(POSITION_SYMBOL) != _Symbol) continue;







      if ((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) == type) count++;







   }







   return count;







}







int OwnPositionCount()







{







   return PosCount(POSITION_TYPE_BUY) + PosCount(POSITION_TYPE_SELL);







}







void CloseAll(string reason)







{







   for (int i = PositionsTotal() - 1; i >= 0; i--)







   {







      ulong ticket = PositionGetTicket(i);







      if (ticket == 0) continue;







      if ((int)PositionGetInteger(POSITION_MAGIC) != g_magic) continue;







      if (PositionGetString(POSITION_SYMBOL) != _Symbol) continue;







      double pnl = 0.0;







      if (PositionSelectByTicket(ticket)) pnl = PositionGetDouble(POSITION_PROFIT);







      if (pnl > 0) Snd(SND_PROFIT); else Snd(SND_SL);







      if (!g_trade.PositionClose(ticket))







      {







         Print("Close failed ticket=", ticket, " reason=", reason, " ret=", g_trade.ResultRetcode());







         Snd(SND_ERROR);







      }







   }







   Print("CLOSEALL reason=", reason, " equity=", AccountInfoDouble(ACCOUNT_EQUITY));







}







void UpdateRiskState()







{







   double eq = AccountInfoDouble(ACCOUNT_EQUITY);







   if (eq > g_peak_equity) g_peak_equity = eq;   // track peak whenever new high







   int day = CurrentDayKey();







   if (day != g_day_key)







   {







      g_day_key = day;







      g_day_start_equity = eq;







      g_daily_locked = false;







      Print("DAY_ROLL day=", day, " equity=", eq);







   }







   SaveRiskState();







}







bool RiskGuardTriggered()







{







   double eq = AccountInfoDouble(ACCOUNT_EQUITY);







   // DAILYLOSS: locks new entries for the server day, resets at day roll.







   if (g_daily_locked)







   {







      g_signal = 0;







      return true;







   }







   if (eq < g_day_start_equity * (1.0 - InpDailyLossPct / 100.0))







   {







      g_daily_locked = true;







      if (OwnPositionCount() > 0) CloseAll("DAILYLOSS");







      g_signal = 0;







      Print("GUARD DAILYLOSS equity=", eq, " day_start=", g_day_start_equity);







      SaveRiskState();







      return true;







   }







   // MAXDD: a DRAWDOWN FLOOR, not a permanent kill switch.







   // Block new entries while equity is below the peak-derived floor, and







   // close the open position once on breach. Auto-resume the moment equity







   // recovers above the floor (no one-way latch -> strategy survives dips).







   double floor = g_peak_equity * (1.0 - InpMaxDDTotalPct / 100.0);







   if (eq < floor)







   {







      if (OwnPositionCount() > 0 && !g_maxdd_active)







      {







         CloseAll("MAXDD");







         g_maxdd_active = true;







         Print("GUARD MAXDD equity=", eq, " peak=", g_peak_equity);







      }







      g_signal = 0;







      return true;   // block new entries until recovery







   }







   g_maxdd_active = false;   // recovered above floor -> resume







   return false;







}







void ComputeSignal()







{







   g_signal = 0;







   if (!MarketOpen()) return;







   if ((double)SymbolInfoInteger(_Symbol, SYMBOL_SPREAD) > InpMinSpreadPts) return;







   if (g_ema_h == INVALID_HANDLE || g_atr_h == INVALID_HANDLE) return;







   double ema_buf[1];







   if (CopyBuffer(g_ema_h, 0, 0, 1, ema_buf) <= 0) return;







   double ema = ema_buf[0];







   if (InpADXMin > 0.0 && g_adx_h != INVALID_HANDLE)







   {







      double adx_buf[1];







      if (CopyBuffer(g_adx_h, 0, 0, 1, adx_buf) <= 0) return;







      if (adx_buf[0] < InpADXMin) return;







   }







   double atr_buf[1];







   if (CopyBuffer(g_atr_h, 0, 0, 1, atr_buf) <= 0) return;







   double close0 = SigClose();







   if (close0 <= 0.0) return;







   double atr_pct = atr_buf[0] / close0 * 100.0;







   if (atr_pct < InpATRPctMin || atr_pct > InpATRPctMax) return;







   // --- D1 Breakout Signal (original) ---







   double highs[];







   double lows[];







   if (!SigCopyHigh(highs, 1, InpBreakoutBars)) return;







   if (!SigCopyLow(lows, 1, InpBreakoutBars)) return;







   double hh = 0.0;







   double ll = 1e18;







   for (int i = 0; i < InpBreakoutBars; i++)







   {







      hh = MathMax(hh, highs[i]);







      ll = MathMin(ll, lows[i]);







   }







   bool breakout_long  = (close0 > ema) && (close0 > hh);







   bool breakout_short = (close0 < ema) && (close0 < ll);







   if (breakout_long)  g_signal = 1;







   else if (breakout_short) g_signal = -1;







   // --- H4 Pullback Signal (additional) ---







   if (g_signal == 0 && InpH4Pullback && g_ema_h4_h != INVALID_HANDLE)







   {







      double ema_h4_buf[1];







      if (CopyBuffer(g_ema_h4_h, 0, 0, 1, ema_h4_buf) > 0)







      {







         double ema_h4 = ema_h4_buf[0];







         // H4 pullback: price pulls back to H4 EMA in direction of D1 trend







         // D1 trend direction







         bool d1_bull = (close0 > ema);







         bool d1_bear = (close0 < ema);







         // Current H4 price







         double h4_close = iClose(_Symbol, PERIOD_H4, 0);







         double h4_open  = iOpen(_Symbol, PERIOD_H4, 0);







         // Pullback depth: how far price pulled back from recent extreme







         double h4_highs[];







         double h4_lows[];







         if (CopyHigh(_Symbol, PERIOD_H4, 1, InpH4PullbackBars, h4_highs) > 0 &&







             CopyLow(_Symbol, PERIOD_H4, 1, InpH4PullbackBars, h4_lows) > 0)







         {







            double h4_hh = 0.0;







            double h4_ll = 1e18;







            for (int i = 0; i < InpH4PullbackBars; i++)







            {







               h4_hh = MathMax(h4_hh, h4_highs[i]);







               h4_ll = MathMin(h4_ll, h4_lows[i]);







            }







            // Pullback to EMA area (within InpH4PullbackDepth * ATR)







            double atr_h4_buf[1];







            int atr_h4_handle = iATR(_Symbol, PERIOD_H4, InpATRPeriod);







            if (atr_h4_handle != INVALID_HANDLE && CopyBuffer(atr_h4_handle, 0, 0, 1, atr_h4_buf) > 0)







            {







               double atr_h4 = atr_h4_buf[0];







               double pullback_zone = atr_h4 * InpH4PullbackDepth;







               // Long pullback: D1 bull, price near H4 EMA from above, not broken below







               if (d1_bull && h4_close > ema_h4 && h4_open > ema_h4 &&







                   h4_close - ema_h4 < pullback_zone &&







                   h4_ll > ema_h4 - pullback_zone)







               {







                  g_signal = 1; // Long pullback entry







               }







               // Short pullback: D1 bear, price near H4 EMA from below, not broken above







               else if (d1_bear && h4_close < ema_h4 && h4_open < ema_h4 &&







                        ema_h4 - h4_close < pullback_zone &&







                        h4_hh < ema_h4 + pullback_zone)







               {







                  g_signal = -1; // Short pullback entry







               }







            }







            IndicatorRelease(atr_h4_handle);







         }







      }







   }







   // --- Copy-trading profile filters (apply to ALL signal lanes) ---







   if (g_signal == -1 && InpLongOnly) g_signal = 0;   // gold secular uptrend: skip shorts







   if (g_signal == 1 && InpEMAGate > 0 && g_ema_gate_h != INVALID_HANDLE)







   {







      double gate_buf[1];







      if (CopyBuffer(g_ema_gate_h, 0, 0, 1, gate_buf) <= 0) { g_signal = 0; return; }







      if (close0 <= gate_buf[0]) g_signal = 0;          // only long above the trend gate







   }







   if (g_signal == -1 && InpEMAGate > 0 && g_ema_gate_h != INVALID_HANDLE)







   {







      // shorts (when long-only disabled) require price BELOW the gate







      double gate_buf2[1];







      if (CopyBuffer(g_ema_gate_h, 0, 0, 1, gate_buf2) <= 0) { g_signal = 0; return; }







      if (close0 >= gate_buf2[0]) g_signal = 0;







   }







}







void OpenPos(ENUM_ORDER_TYPE type)







{







   if (!MarketOpen() || OwnPositionCount() != 0) return;







   double lot = ComputeLot();







   if (lot < InpMinLot) lot = InpMinLot;







   double price = (type == ORDER_TYPE_BUY) ? SymbolInfoDouble(_Symbol, SYMBOL_ASK)







                                           : SymbolInfoDouble(_Symbol, SYMBOL_BID);







   double sl = (type == ORDER_TYPE_BUY)







             ? NormalizeDouble(price - InpStopLossPts * g_point, g_digits)







             : NormalizeDouble(price + InpStopLossPts * g_point, g_digits);







   // No broker TP: partial close + remainder trail are managed in code (ManagePartial/TrailAll).







   bool ok = (type == ORDER_TYPE_BUY)







           ? g_trade.Buy(lot, _Symbol, price, sl, 0.0, "systematic-v1 BUY")







           : g_trade.Sell(lot, _Symbol, price, sl, 0.0, "systematic-v1 SELL");







   if (ok && g_trade.ResultRetcode() == TRADE_RETCODE_DONE)







   {







      g_signal = 0;







      g_partial_ticket = 0;







      Print("OPEN ", (type == ORDER_TYPE_BUY ? "BUY" : "SELL"), " lot=", lot, " sl=", sl);







      if (AgainstTrend(type)) Snd(SND_LAWAN); else Snd(SND_OPEN);







   }







   else







   {







      Snd(SND_ERROR);







      Print("OPEN FAILED side=", (type == ORDER_TYPE_BUY ? "BUY" : "SELL"),







            " ret=", g_trade.ResultRetcode(), " lot=", lot, " sl=", sl);







   }







}







void ManagePartial()







{







   if (!InpPartialTP) return;







   // Position gone (closed/flat) -> allow a new position to take its partial.







   if (g_partial_ticket != 0)







   {







      bool found = false;







      for (int i = PositionsTotal() - 1; i >= 0; i--)







      {







         ulong t = PositionGetTicket(i);







         if (t == g_partial_ticket) { found = true; break; }







      }







      if (!found) g_partial_ticket = 0;







   }







   if (OwnPositionCount() == 0) return;







   // Locate our single own position.







   ulong ticket = 0;







   ENUM_POSITION_TYPE ptype = POSITION_TYPE_BUY;







   double open = 0.0, vol = 0.0;







   for (int i = PositionsTotal() - 1; i >= 0; i--)







   {







      ulong t = PositionGetTicket(i);







      if (t == 0) continue;







      if ((int)PositionGetInteger(POSITION_MAGIC) != g_magic) continue;







      if (PositionGetString(POSITION_SYMBOL) != _Symbol) continue;







      ticket = t;







      ptype = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);







      open = PositionGetDouble(POSITION_PRICE_OPEN);







      vol = PositionGetDouble(POSITION_VOLUME);







      break;







   }







   if (ticket == 0) return;







   if (ticket == g_partial_ticket) return;   // already took partial on this ticket







   double cur = (ptype == POSITION_TYPE_BUY) ? SymbolInfoDouble(_Symbol, SYMBOL_BID)







                                            : SymbolInfoDouble(_Symbol, SYMBOL_ASK);







   double profit_pts = (ptype == POSITION_TYPE_BUY) ? (cur - open) / g_point







                                                     : (open - cur) / g_point;







   double trig = InpStopLossPts * InpPartialTPMult;   // 1R







   if (profit_pts < trig) return;







   // Close InpPartialFrac of the position volume (respect broker min lot).







   double half = NormalizeDouble(vol * InpPartialFrac, 2);







   if (half < InpMinLot) half = InpMinLot;







   if (half >= vol) half = vol;   // tiny position: close all instead of leaving dust







   bool ok = g_trade.PositionClosePartial(ticket, half);







   if (!ok)







   {







      Print("PARTIAL FAILED ticket=", ticket, " half=", half, " ret=", g_trade.ResultRetcode());







      Snd(SND_ERROR);







      return;







   }







   g_partial_ticket = ticket;







   g_partial_open = open;







   // Move remainder SL to breakeven so the remaining 50% is risk-free; TrailAll then trails it.







   double be = (ptype == POSITION_TYPE_BUY)







             ? NormalizeDouble(open + InpMinSpreadPts * g_point, g_digits)







             : NormalizeDouble(open - InpMinSpreadPts * g_point, g_digits);







   if (!g_trade.PositionModify(ticket, be, 0.0))







      Print("PARTIAL BE-MODIFY FAILED ticket=", ticket, " ret=", g_trade.ResultRetcode());







   Print("PARTIAL ", DoubleToString(InpPartialFrac * 100, 0), "% ticket=", ticket, " half=", half, " be_sl=", be);







   if (profit_pts >= 10000) Snd(SND_JACKPOT); else Snd(SND_TP);







}







void TrailAll()







{







   // Skip trailing at session boundaries (00:00-00:05) to avoid retcode 10018







   MqlDateTime dt;







   TimeCurrent(dt);







   if (dt.hour == 0 && dt.min < 5) return;







   for (int i = PositionsTotal() - 1; i >= 0; i--)







   {







      ulong ticket = PositionGetTicket(i);







      if (ticket == 0) continue;







      if ((int)PositionGetInteger(POSITION_MAGIC) != g_magic) continue;







      if (PositionGetString(POSITION_SYMBOL) != _Symbol) continue;







      ENUM_POSITION_TYPE type = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);







      double open = PositionGetDouble(POSITION_PRICE_OPEN);







      double old_sl = PositionGetDouble(POSITION_SL);







      double cur = (type == POSITION_TYPE_BUY) ? SymbolInfoDouble(_Symbol, SYMBOL_BID)







                                               : SymbolInfoDouble(_Symbol, SYMBOL_ASK);







      double profit_pts = (type == POSITION_TYPE_BUY) ? (cur - open) / g_point







                                                       : (open - cur) / g_point;







      if (profit_pts <= InpTrailingStartPts) continue;







      double new_sl = (type == POSITION_TYPE_BUY)







                    ? NormalizeDouble(cur - InpTrailingStepPts * g_point, g_digits)







                    : NormalizeDouble(cur + InpTrailingStepPts * g_point, g_digits);







      bool better = (type == POSITION_TYPE_BUY) ? (new_sl > old_sl && old_sl > 0.0)







                                                : (new_sl < old_sl || old_sl == 0.0);







      if (better && !g_trade.PositionModify(ticket, new_sl, 0))







         Print("TRAIL FAILED ticket=", ticket, " ret=", g_trade.ResultRetcode());







   }







}







// --- Sound helpers ---







datetime g_snd_guard = 0;







bool Snd(string file)







{







   if (!InpSoundEnabled || IsTester()) return false;







   PlaySound(file);







   g_snd_guard = TimeCurrent();







   return true;







}







bool AgainstTrend(ENUM_ORDER_TYPE type)







{







   double eb[1];







   if (g_ema_h == INVALID_HANDLE || CopyBuffer(g_ema_h, 0, 0, 1, eb) <= 0) return false;







   double close0 = SigClose();







   if (type == ORDER_TYPE_BUY)  return close0 < eb[0];







   if (type == ORDER_TYPE_SELL) return close0 > eb[0];







   return false;







}







void OnTradeTransaction(const MqlTradeTransaction& trans,







                        const MqlTradeRequest& request,







                        const MqlTradeResult& result)







{







   if (trans.type != TRADE_TRANSACTION_DEAL_ADD) return;







   if (!HistoryDealSelect(trans.deal)) return;







   long entry = HistoryDealGetInteger(trans.deal, DEAL_ENTRY);







   long reason = HistoryDealGetInteger(trans.deal, DEAL_REASON);







   double profit = HistoryDealGetDouble(trans.deal, DEAL_PROFIT);







   string sym = HistoryDealGetString(trans.deal, DEAL_SYMBOL);







   if (sym != _Symbol) return;







   if ((long)HistoryDealGetInteger(trans.deal, DEAL_MAGIC) != g_magic) return;







   if (entry != DEAL_ENTRY_OUT) return;  // only handle broker closes here







   // Trail exits fire as DEAL_REASON_SL via the modified stop; judge by profit sign.







   if (reason == DEAL_REASON_SL) { Snd(profit > 0 ? SND_PROFIT : SND_SL); return; }







   if (reason == DEAL_REASON_TP) { Snd(SND_TP); return; }







   // DEAL_REASON_CLIENT = code-managed close (partial/closeall) -> sound in its own code path







}







// ---- Prabowo pixel-art pet (6px cells 32x34, OBJ_RECTANGLE_LABEL) ----

void PetRect(string name, int x, int y, int w, int h, color clr)

{

   if (ObjectFind(0, name) < 0)

   {

      ObjectCreate(0, name, OBJ_RECTANGLE_LABEL, 0, 0, 0);

      ObjectSetInteger(0, name, OBJPROP_CORNER, CORNER_LEFT_UPPER);

      ObjectSetInteger(0, name, OBJPROP_BORDER_TYPE, BORDER_FLAT);

      ObjectSetInteger(0, name, OBJPROP_BACK, false);

      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);

   }

   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, x);

   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, y);

   ObjectSetInteger(0, name, OBJPROP_XSIZE, w);

   ObjectSetInteger(0, name, OBJPROP_YSIZE, h);

   ObjectSetInteger(0, name, OBJPROP_BGCOLOR, clr);

}



