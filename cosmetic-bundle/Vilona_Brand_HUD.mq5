//| Vilona Systematic v1 - conservative, non-hedging D1 breakout EA   |







//| Derived from the verified Vilona HS v119p signal and risk model.   |







//| Contract: one own position at a time; no grid, hedge, or recovery. |







//| v2: Fixed trail failures, added partial TP, added H4 pullback entry. |







#property strict







#include <Trade/Trade.mqh>



#include <Canvas/Canvas.mqh>







CCanvas g_pet;







CTrade g_trade;







// --- Inputs ---







input double InpRiskPct           = 8.00;   // equity risk per full stop (growth profile, WF-validated)







input double InpMaxLot            = 50.00;  // hard lot cap







input double InpMinLot            = 0.01;   // broker-compatible lot floor







input int    InpSignalTF          = 1440;   // 240=H4, 1440=D1, 60=H1







input int    InpBreakoutBars      = 5;      // prior signal-TF bars







input int    InpEMATrend          = 200;    // trend EMA period







input double InpADXMin            = 0.0;    // 0 = disabled







input int    InpADXPeriod         = 14;







input int    InpATRPeriod         = 14;







input double InpATRPctMin         = 0.1;







input double InpATRPctMax         = 20.0;







input double InpStopLossPts       = 8000;







input double InpTrailingStartPts  = 15000;







input double InpTrailingStepPts   = 8000;







input double InpMinSpreadPts      = 300;







input double InpDailyLossPct      = 3.0;    // lock new entries for the server day (cooling)







input double InpMaxDDTotalPct     = 20.0;   // transient drawdown floor (auto-resume on recovery)







input int    InpMagic             = 119501;







input bool   InpLongOnly          = true;   // copy-trading profile: long-only (gold secular uptrend)







input int    InpEMAGate           = 50;     // require close > EMA(N) on signal TF for LONGs (0=off)







// --- Partial TP / H4 Pullback ---







input bool    InpPartialTP         = true;    // bank part of the position at 1R







input double InpPartialFrac       = 0.30;    // fraction closed at 1R (0.30 = walk-forward validated)







input double InpPartialTPMult      = 1.0;     // TP at 1R for partial







input bool    InpH4Pullback        = true;    // D1 trend + H4 pullback entry







input int    InpH4EMA             = 20;       // H4 EMA for pullback







input int    InpH4PullbackBars     = 5;       // H4 pullback lookback







input double InpH4PullbackDepth    = 0.5;     // pullback depth as fraction of ATR







// --- Sound alerts ---







input bool    InpSoundEnabled      = true;    // play WAV alerts on events







input bool    InpPetEnabled        = true;    // show pet animation on chart
input bool    InpBrandHUDOnly     = false;   // true = brand HUD mode (no trading)







// --- Sound files (drop WAVs into <data>\MQL5\Files\) ---







#define SND_OPEN        "tgdh_open.wav"     // position opened







#define SND_LAWAN       "tgdh_lawan.wav"    // opened AGAINST the trend







#define SND_TP          "tgdh_tp.wav"       // partial TP (1R) banked







#define SND_JACKPOT     "tgdh_jackpot.wav"  // profit >= 1000 pips







#define SND_SL          "tgdh_sl.wav"       // stop loss hit (loss close)







#define SND_PROFIT      "tgdh_profit.wav"   // full close with profit







#define SND_MARGIN      "tgdh_margin.wav"   // margin level < 100%







#define SND_ERROR       "tgdh_error.wav"    // order / modify failed







int      g_magic = 119501;







double   g_point = 0.01;







int      g_digits = 5;







double   g_peak_equity = 0.0;







double   g_day_start_equity = 0.0;







int      g_day_key = 0;







bool     g_maxdd_active = false;     // transient: true while equity is below MAXDD floor







bool     g_daily_locked = false;







int      g_signal = 0;







int      g_ema_h = INVALID_HANDLE;







int      g_ema_h4_h = INVALID_HANDLE;  // H4 EMA for pullback







int      g_ema_gate_h = INVALID_HANDLE; // EMA gate for long entries (copy-trading profile)







int      g_adx_h = INVALID_HANDLE;







int      g_atr_h = INVALID_HANDLE;







ulong    g_partial_ticket = 0;     // ticket that already took the 50% partial close







double   g_partial_open = 0.0;     // open price of the position that took partial







datetime g_last_risk_save = 0;







bool IsTester()







{







   return (MQLInfoInteger(MQL_TESTER) != 0);







}







int CurrentDayKey()







{







   MqlDateTime dt;







   TimeCurrent(dt);







   return dt.year * 10000 + dt.mon * 100 + dt.day;







}







// --- HUD panel (chart overlay) ---







#define HUD_PREFIX "VBH_"







int      g_hud_obj_count = 0;







int      g_hud_created = 0;







int      g_pet_frame = 0;







int      g_pet_x = 0;







string   g_hud_names[];

double   g_eq_hist[140];

int      g_eq_hist_n = 0;

datetime g_eq_last_t = 0;







string Money(double v)

{

   bool neg = (v < 0);

   string s = DoubleToString(MathFloor(MathAbs(v)), 0);

   string r = "";

   int n = StringLen(s);

   for (int i = 0; i < n; i++)

   {

      r += CharToString((uchar)StringGetCharacter(s, i));

      if ((n - 1 - i) % 3 == 0 && i < n - 1) r += ",";

   }

   return (neg ? "-$" : "$") + r;

}





void HudObj(string name, int type, int x, int y, int w, int h)







{







   string full = HUD_PREFIX + name;







   if (type == 0)  // OBJ_RECTANGLE_LABEL







   {







      if (ObjectCreate(0, full, OBJ_RECTANGLE_LABEL, 0, 0, 0))







      {







         ObjectSetInteger(0, full, OBJPROP_CORNER, CORNER_LEFT_UPPER);







         ObjectSetInteger(0, full, OBJPROP_XDISTANCE, x);







         ObjectSetInteger(0, full, OBJPROP_YDISTANCE, y);







         ObjectSetInteger(0, full, OBJPROP_XSIZE, w);







         ObjectSetInteger(0, full, OBJPROP_YSIZE, h);







         ObjectSetInteger(0, full, OBJPROP_BGCOLOR, clrDarkSlateGray);







         ObjectSetInteger(0, full, OBJPROP_BORDER_TYPE, BORDER_FLAT);







         ObjectSetInteger(0, full, OBJPROP_BACK, false);







      }







   }







   else  // OBJ_LABEL







   {







      if (ObjectCreate(0, full, OBJ_LABEL, 0, 0, 0))







      {







         ObjectSetInteger(0, full, OBJPROP_CORNER, CORNER_LEFT_UPPER);







         ObjectSetInteger(0, full, OBJPROP_XDISTANCE, x);







         ObjectSetInteger(0, full, OBJPROP_YDISTANCE, y);







         ObjectSetString(0, full, OBJPROP_TEXT, " ");







         ObjectSetInteger(0, full, OBJPROP_FONTSIZE, 8);







         ObjectSetString(0, full, OBJPROP_FONT, "Consolas");







      }







   }







   ObjectSetInteger(0, full, OBJPROP_SELECTABLE, false);







   ObjectSetInteger(0, full, OBJPROP_HIDDEN, true);







   g_hud_obj_count++;







   ArrayResize(g_hud_names, g_hud_obj_count);







   g_hud_names[g_hud_obj_count - 1] = full;







}







void HudText(string name, string text, color clr)







{







   string full = HUD_PREFIX + name;







   ObjectSetString(0, full, OBJPROP_TEXT, text);







   ObjectSetInteger(0, full, OBJPROP_COLOR, clr);







}







